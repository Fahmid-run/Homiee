{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDirs": ["./src/app", "./prisma/generated/prisma"]
  },
  "include": [
    "src/**/*",
    "prisma/generated/prisma/**/*",
    "src/types/express.d.ts"
  ]
}
