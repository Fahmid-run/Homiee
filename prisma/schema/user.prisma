model User {
  id               String   @id @default(uuid())
  name             String
  email            String
  password         String?
  isEmailVerified  Boolean? @default(false)
  isGoogleVerified Boolean? @default(false)
  googleId         String?
  gender           Gender   @default(MALE)

  role      Role       @default(TENANT)
  status    UserStatus @default(ACTIVE)
  isDeleted Boolean    @default(false)

  propertyOwner       PropertyOwner?
  tenantProfile       TenantProfile?
  applications        Application[]
  viewingRequests     ViewingRequest[]
  tenancies           Tenancy[]
  rentalPayments      RentalPayment[]
  billshares          UtilityBillShare[]
  uploadedDocuments   RentalDocuments[]
  reviewedApplicaions Application[]      @relation("ApplicationReviewer")

  roomMateMatchAsA RoomMateMatch[] @relation("MatchTenantA")
  roomMateMatchAsB RoomMateMatch[] @relation("MatchTenantB")
  

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@map("users")
}
