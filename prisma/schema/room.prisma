model Room {
  id String @id @default(uuid())

  roomNumber  String
  propertyId  String
  roomType    RoomType
  monthlyRent Int
  capacity    Int

  roomstatus RoomStatus @default(AVAILABLE)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  applications    Application[]
  viewingRequests ViewingRequest[]
  tenancy         Tenancy[]

  @@unique([roomNumber])
  @@map("room")
}
