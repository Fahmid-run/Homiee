model Application {
  id String @id @default(uuid())

  tenantId String
  message  String?

  status     ApplicationStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  tenant     User              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reviewer  User?    @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: Cascade)
  tenancy   Tenancy?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("application")
}
