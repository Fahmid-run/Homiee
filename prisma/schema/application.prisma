model Application {
  id String @id @default(uuid())

  tenantId String
  roomId   String

  message String?

  status     ApplicationStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?         @updatedAt
  tenant     User              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reviewer  User?    @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: Cascade)
  tenancy   Tenancy?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("application")
}
